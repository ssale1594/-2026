# انسخ هذا الملف إلى .env.local (محمي من Git تلقائيًا) واملأ القيم الحقيقية
# بعد إنشاء مشروع Supabase من supabase.com/dashboard

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# نطاق الموقع — يُستخدم بـsitemap.xml وrobots.txt. محليًا اتركه فاضي.
NEXT_PUBLIC_SITE_URL=

# سري — لا يُستخدم إلا سيرفر-سايد (webhooks, cron). لا يظهر أبدًا للمتصفح.
SUPABASE_SERVICE_ROLE_KEY=

# بوابة الدفع (Tap) — انظر TECH.md
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=

# سري — يهشّر IP الزائر قبل تخزينه (حد يومي على عدّادات المشاهدة/التواصل).
# أي قيمة عشوائية طويلة تكفي: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERACTION_HASH_SECRET=

# ============== إعدادات البريد الإلكتروني للإشعارات ==============
# الخيار الأول (الأسهل): Resend.com — احصل على مفتاح مجاني من resend.com (3000 رسالة/يوم مجانًا)
RESEND_API_KEY=

# الخيار الثاني: Brevo (ex-Sendinblue) — يمنح 300 رسالة/يوم مجانية
BREVO_API_KEY=

# عنوان المرسل (يجب أن يكون نطاقك المُتحقق في مزود البريد)
EMAIL_FROM=notifications@your-domain.com
EMAIL_FROM_NAME=منصة سوق الزلفي

# سري — يُستخدم للاستدعاء الآمن لوحدة إرسال البريد عبر Cron (Vercel Cron أو خارجي)
# أنشئ قيمة عشوائية طويلة: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_WORKER_TOKEN=

# ============================================================
# مساعد كتابة الإعلانات (معطّل افتراضيًا)
# ============================================================
# الكود جاهز لكنه لا يعمل إلا بضبط المتغيّرين معًا. كل استدعاء
# يكلّف مالًا، ومبدأ المشروع ألا ندفع قبل وجود دخل فعلي.
# الحد: 10 مسودات يوميًا لكل بائع (يفرضه claim_ai_quota بالقاعدة).
# ANTHROPIC_API_KEY=sk-ant-...
# AI_LISTING_WRITER_ENABLED=1
